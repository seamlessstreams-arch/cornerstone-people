# --- Database (PostgreSQL) ---
# DATABASE_URL  : runtime connection. On Vercel/Neon this is the POOLED url.
# DIRECT_URL    : direct, non-pooled connection used for `prisma migrate deploy`.
#
# Local development (e.g. a local Postgres):
DATABASE_URL="postgresql://postgres@localhost:5432/cornerstone?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/cornerstone?schema=public"
#
# On Vercel with the Neon integration, set:
#   DATABASE_URL = <Neon POOLED connection string>
#   DIRECT_URL   = <Neon UNPOOLED / direct connection string>

# Secret used to sign session cookies. Use a long random value in production.
SESSION_SECRET="change-me-in-production-to-a-long-random-string"

# --- AI agents (optional) ---
# The Safer Recruitment OS works fully with NO keys: every agent falls back to
# deterministic rule-based output (lib/safer-recruitment.ts). AI may only ever
# refine a labelled DRAFT — it never makes a recruitment decision.
# AI_PROVIDER     : "anthropic" | "openai" (omit to force rule-based)
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Email (optional) ---
# With no key, the UI shows "copy email text" for reference requests/chasers.
# EMAIL_PROVIDER  : "resend"
EMAIL_PROVIDER=""
RESEND_API_KEY=""
