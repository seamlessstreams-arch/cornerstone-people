// Keni — data model for the MVP.
//
// The core mechanic: two sides build profiles, either side can express
// interest, and identity + a conversation unlock ONLY when interest is mutual.
//
// "enum-like" fields are stored as strings and constrained in application code
// (see lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection — may be a pooled (pgbouncer) URL on Vercel/Neon.
  url       = env("DATABASE_URL")
  // Direct, non-pooled connection used for migrations (prisma migrate deploy).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // "CANDIDATE" | "EMPLOYER"
  createdAt    DateTime @default(now())

  candidate Candidate?
  employer  Employer?
  sessions  Session[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Candidate (the supply side)
// ---------------------------------------------------------------------------

model Candidate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Layer 0 — candidate-controlled visibility mode.
  // "ANONYMOUS" (default, safer) | "OPEN"
  visibilityMode String @default("ANONYMOUS")

  // --- Structured fields: PRE-MUTUAL SAFE (shown on the anonymised card) ---
  region          String? // e.g. "Greater Manchester"
  shiftPattern    String? // shift availability
  youngPeopleType String? // type of young people they want to support
  experienceLevel String? // experience level
  roleType        String? // role type sought
  valuesTags      String? // comma-separated therapeutic approach / values tags

  // --- Sealed fields: NARRATIVE / IDENTITY (unlock only on mutual match,
  //     or — for name/photo/history — in OPEN mode to non-blocked employers) ---
  fullName          String?
  photoUrl          String?
  employmentHistory String? // free text
  narrative         String? // "what matters to me" free text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  references     Reference[]
  interests      Interest[]
  blocks         Block[]
  matches        Match[]
  saferCases     SaferRecruitmentCase[]
  storedFiles    StoredFile[]
}

// Candidate-side reference verification ONLY.
// We deliberately do NOT store reliability ratings / suitability comments about
// referees (the cross-employer "reference bank") — that is GDPR + defamation
// exposure and is out of scope for the MVP (see brief §5).
model Reference {
  id           String   @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  refereeName  String
  refereeEmail String
  relationship String // e.g. "Former line manager"
  status       String   @default("PENDING") // "PENDING" | "VERIFIED"
  token        String   @unique
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Employer (the demand side)
// ---------------------------------------------------------------------------

model Employer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // companyName must be searchable so candidates can find & block them (Layer 1).
  companyName      String
  region           String?
  sellingPoints    String?
  ethos            String?
  childrenSupported String?
  placementPicture String?
  shiftPattern     String?
  supportOffered   String?
  compensation     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  interests Interest[]
  blocks    Block[]
  matches   Match[]
  saferCases      SaferRecruitmentCase[]
  referenceBank   ReferenceBankEntry[]
  storedFiles     StoredFile[]
  talentProspects TalentProspect[]
}

model Position {
  id          String   @id @default(cuid())
  employerId  String
  employer    Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  region      String?
  shiftPattern String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// The connection: interest, blocks, matches, messages
// ---------------------------------------------------------------------------

// One directional expression of interest between a candidate and an employer.
// A Match is formed when BOTH directions exist for the same pair.
model Interest {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  // who expressed it: "CANDIDATE" | "EMPLOYER"
  direction   String
  createdAt   DateTime @default(now())

  @@unique([candidateId, employerId, direction])
}

// Candidate blocks an employer. Silent and undetectable from the employer side.
model Block {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([candidateId, employerId])
}

// Created when interest becomes mutual. Unlocks identity + a message thread.
model Match {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  // The single next step the MVP supports.
  interviewRequestedBy String? // "CANDIDATE" | "EMPLOYER"
  interviewRequestedAt DateTime?

  messages  Message[]
  saferCase SaferRecruitmentCase?

  @@unique([candidateId, employerId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderRole String  // "CANDIDATE" | "EMPLOYER"
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Safer Recruitment OS
//
// A case is opened by an employer AFTER a mutual match (identity unlocked), so
// every case maps 1:1 to a Match. The case is the spine that the references,
// employment-gap review, DBS workflow and audit trail hang off. Nothing here
// auto-decides appointment, rejection or "can start" — those stages require a
// human to set them (see SR_HUMAN_SIGNOFF_STAGES in lib/constants).
// ---------------------------------------------------------------------------

model SaferRecruitmentCase {
  id          String   @id @default(cuid())
  matchId     String   @unique
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  employerId  String
  employer    Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  stage       String  @default("APPLICATION_RECEIVED") // SR_STAGES
  notes       String?

  // Human sign-off record for the irreversible decisions. Stored separately
  // from any AI/rule-based output (principle: store AI output and human
  // decision separately).
  clearedToStartBy String?
  clearedToStartAt DateTime?
  decisionBy       String?
  decisionAt       DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  references       ReferenceRequest[]
  gapReview        EmploymentGapReview?
  dbsCheck         DbsCheck?
  identityCheck    IdentityRightToWorkCheck?
  exceptionalStart ExceptionalStartAssessment?
  qualifications   QualificationRecord[]
  storedFiles      StoredFile[]
}

// Reusable, employer-scoped referee / organisation contact details.
// This is factual contact/process data the employer maintains for itself —
// NOT cross-employer opinions about a candidate.
model ReferenceBankEntry {
  id         String   @id @default(cuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  organisationName String
  organisationType String?
  hrEmail          String?
  hrPhone          String?
  portalLink       String?
  refereeName      String?
  refereeRole      String?
  refereeEmail     String?
  refereePhone     String?
  address          String?
  preferredMethod  String?  // REFERENCE_REQUEST_METHODS
  consentFormRequired Boolean @default(false)
  phoneVerificationAccepted Boolean @default(false)
  factualOnly      Boolean @default(false)
  providesSafeguardingComment Boolean @default(false)
  documentsRequired String?
  chasePattern      String?
  averageResponseDays Int?
  reliabilityRating Int?     // 1–5, employer's own private note
  lastUsedAt       DateTime?
  notes            String?

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests ReferenceRequest[]
}

model ReferenceRequest {
  id      String   @id @default(cuid())
  caseId  String
  case    SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  bankEntryId String?
  bankEntry   ReferenceBankEntry? @relation(fields: [bankEntryId], references: [id], onDelete: SetNull)

  referenceType String          // REFERENCE_TYPES
  refereeName   String
  refereeEmail  String?
  refereeOrg    String?
  method        String?         // REFERENCE_REQUEST_METHODS
  status        String @default("DRAFT") // REFERENCE_REQUEST_STATUS

  consentRecorded Boolean @default(false)

  sentAt        DateTime?
  chaser1At     DateTime?
  chaser2At     DateTime?
  finalChaserAt DateTime?
  receivedAt    DateTime?

  verbalVerifiedBy String?
  verbalVerifiedAt DateTime?

  // Received reference content + analyser output (kept separate from the
  // human disposition).
  responseText  String?
  qualityStatus String?         // REFERENCE_QUALITY (rule-based analyser)
  qualityNotes  String?         // human-readable analyser explanation
  disposition   String?         // REFERENCE_DISPOSITIONS (human decision)
  concernFlag   Boolean @default(false)
  rmReviewRequested Boolean @default(false)

  // Public mobile reference form — a one-time link the referee completes
  // themselves. Captures provenance (IP / user-agent / timestamp) for the audit
  // trail; the rule-based analyser runs on submission just as for a pasted one.
  publicToken                String?   @unique
  tokenExpiresAt             DateTime?
  submittedIp                String?
  submittedUserAgent         String?
  refereeJobTitle            String?
  refereeAuthorisedConfirmed Boolean   @default(false)
  workedWithChildren         Boolean?
  wouldReEmploy              Boolean?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmploymentGapReview {
  id      String @id @default(cuid())
  caseId  String @unique
  case    SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // JSON-encoded array of detected findings (from the rule-based checker).
  findings String?
  status   String @default("NEEDS_EXPLANATION") // EMPLOYMENT_GAP_STATUS
  managerNotes String?

  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DbsCheck {
  id      String @id @default(cuid())
  caseId  String @unique
  case    SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status           String?  // e.g. "Clear", "Pending", "Awaiting certificate"
  certificateDate  DateTime?
  level            String?  // DBS_LEVELS
  workforceType    String?  // DBS_WORKFORCE_TYPES
  barredListChecked Boolean @default(false)
  updateService    Boolean @default(false)
  updateServiceConsent Boolean @default(false)
  dateChecked      DateTime?
  certificateSeen  Boolean @default(false)
  riskReviewRequired Boolean @default(false)
  notes            String?

  checkedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Identity + right-to-work evidence for a case. Mandatory pre-employment
// checks: a candidate may not start without a right-to-work check, and missing
// identity evidence is a hard blocker. Evidence workflow only — the actual
// document/likeness confirmation is always a named human's act.
model IdentityRightToWorkCheck {
  id     String               @id @default(cuid())
  caseId String               @unique
  case   SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Identity
  identityDocumentType     String?
  identityDocumentSeen     Boolean @default(false)
  photographSeen           Boolean @default(false)
  likenessConfirmed        Boolean @default(false)
  nameDiscrepancyExplained Boolean @default(false)

  // Right to work
  rightToWorkVerified Boolean   @default(false)
  rightToWorkMethod   String? // "Manual document check" | "Online share code" | ...
  shareCode           String?
  timeLimited         Boolean   @default(false)
  followUpDate        DateTime? // for time-limited permission

  checkedBy String?
  checkedAt DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Risk assessment + supervision plan for an exceptional (supervised) start —
// where a candidate begins before every check is complete. Approval is a named
// RM/RI act and requires all hard supervision controls to be in place; this is
// never set automatically.
model ExceptionalStartAssessment {
  id     String               @id @default(cuid())
  caseId String               @unique
  case   SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  status String @default("DRAFT")

  businessReason    String?
  outstandingChecks String? // snapshot of what is still outstanding
  riskLevel         String? // low | moderate | high
  riskMitigation    String?

  // Hard supervision controls
  supervisorName       String?
  noSoleCharge         Boolean @default(false)
  noUnsupervisedAccess Boolean @default(false)
  noIntimateCare       Boolean @default(false)
  noOvernight          Boolean @default(false)
  supervisionNotes     String?
  reviewDate           DateTime?

  // Named RM/RI approval (the human gate)
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A qualification, mandatory-training certificate or professional registration
// on a candidate's staff file. Many per case. "Required" entries that aren't yet
// evidenced surface as outstanding on the case.
model QualificationRecord {
  id     String               @id @default(cuid())
  caseId String
  case   SaferRecruitmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  title              String
  kind               String? // Qualification | Mandatory training | ...
  required           Boolean   @default(false)
  certificateSeen    Boolean   @default(false)
  verifiedWithIssuer Boolean   @default(false)
  reference          String? // certificate number / URN
  awardedOn          DateTime?
  expiresOn          DateTime?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

// Append-only audit trail for important actions (principle 9).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // User.id, or null for system / token actions
  actorEmail String?
  actorRole  String?
  action     String   // e.g. "REFERENCE_REQUEST_SENT"
  entityType String?  // e.g. "SaferRecruitmentCase"
  entityId   String?
  summary    String?
  meta       String?  // JSON details
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Metadata for files held in private Supabase Storage buckets. The bytes live
// in Storage; this row records where, who owns it, and what it is, so access
// can be authorized in application code before a signed URL is minted.
model StoredFile {
  id           String   @id @default(cuid())
  bucket       String   // BucketName (lib/storage.ts)
  path         String   // object path within the bucket
  originalName String
  contentType  String?
  size         Int?
  kind         String?  // e.g. "cv" | "certificate" | "reference" | "document"

  // Optional ownership links — exactly one is typically set.
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String?
  employer    Employer?  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  caseId      String?
  case        SaferRecruitmentCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([candidateId])
  @@index([caseId])
}

// Single-use, time-limited password reset tokens. The token is delivered to the
// user's email (never shown in the UI) so possession of an inbox proves
// ownership — the standard "forgot password" pattern.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Employer-private talent pipeline of prospects recorded BY NAME ONLY.
//
// Deliberately stores no contact details — it is a lightweight, consent-light
// list of people an employer is already lawfully sourcing (e.g. applicants they
// received), to track until the person is invited to create a real, consented
// candidate profile. The employer is the data controller for these entries.
// This is manual entry only; the platform never scrapes or imports them.
model TalentProspect {
  id         String   @id @default(cuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  name   String   // name only — no email/phone fields by design
  source String?  // free text, e.g. "CV-Library application", "referral"
  note   String?
  stage  String   @default("NEW") // NEW | REVIEWING | INVITED | ARCHIVED

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employerId])
}
